# Base URL (pre = test sandbox, my = production)
# Real Birbank Biznes creds work only on prod (my.birbank.business).
BIRBANK_BASE=https://my.birbank.business

# B2B login credentials.
# Username = 7-digit customer code + trailing letter (e.g. 0123456A).
# Issued by Kapital Bank after API contract is signed via ASAN İmza
# on https://api.birbank.business.
# Password = the one you set yourself in Birbank Biznes / API portal.
BIRBANK_USERNAME=0123456A
BIRBANK_PASSWORD=ChangeMeExample1

# Telegram notification (optional; falls back to stdout if either is blank)
# Bot token from @BotFather, chat_id from getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=1234567890:AAExampleBotTokenStringFromBotFatherHere
TELEGRAM_CHAT_ID=123456789

# Where to persist last-seen balances + cached jwt (relative to working dir)
BIRBANK_STATE=state.json
BIRBANK_TOKEN_FILE=token.json
BIRBANK_LOCK=.poller.lock

# 0 = one-shot (cron / launchd schedules it).  >0 = run forever, sleep N sec.
POLL_INTERVAL_S=0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
